# Contoh konfigurasi Deploy.com (OpenAI-compatible)
ELYSIA_PROVIDER=openai-compatible
ELYSIA_BASE_URL=
ELYSIA_API_KEY=
ELYSIA_MODEL=

# Pengaturan respons lebih ringan:
ELYSIA_MAX_HISTORY_TURNS=6
ELYSIA_MAX_OUTPUT_TOKENS=350
ELYSIA_API_TIMEOUT=60
ELYSIA_API_MAX_RETRIES=0

# Untuk Gemini, ubah provider menjadi gemini, lalu gunakan GEMINI_API_KEY
# dan model Gemini yang tersedia:
# ELYSIA_PROVIDER=gemini
# GEMINI_API_KEY=isi_api_key_gemini_di_sini
# ELYSIA_MODEL=gemini-3.1-flash-lite

# Opsional: lokasi file riwayat percakapan
# ELYSIA_HISTORY_FILE=conversation.json
